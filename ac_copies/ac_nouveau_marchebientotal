    def build_hf_cache(modelname, params_names):
        class HFCache:
            def __init__(self):
                self._last_u = None
                self._last_g = None
                self._last_grad = None

            def run_if_needed(self, u):
                u_list = list(u)
                if self._last_u is None or u_list != self._last_u:
                    self._last_g, self._last_grad, _ = run_HF(modelname, params_names, u)
                    self._last_u = u_list
        hf_cache = HFCache()
        return hf_cache

    # --------------------------------------------------------------------------- #
