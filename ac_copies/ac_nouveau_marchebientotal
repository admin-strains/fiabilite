    # --- DOE ---
    def build_DOE():
        with open("C:\\workspace\\storage\\semia\\" + modelname + ".ds\\dsCad.txt", 'r') as f:
            d = float(re.search(r'^phi\s*=\s*([\d.]+)', f.read(), re.MULTILINE).group(1))
