            d = float(re.search(r'^phi\s*=\s*([\d.]+)', f.read(), re.MULTILINE).group(1))
        dist.append(loi_fy(d=d, fy=500))
    #AJOUTER suite pour plus de variable 'if 'load' in params_names' etc.
    dist_X   = ot.JointDistribution(dist)
    return dist_X

