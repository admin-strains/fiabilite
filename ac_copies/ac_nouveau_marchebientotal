    # --- GEKPLS ---
    def build_metamodel_GEK(xt, yt, all_grad):
        xlimits = np.column_stack([xt.min(axis=0) - 1, xt.max(axis=0) + 1])

        sm = GEKPLS(
            n_comp=2,
            theta0=[1e-2, 1e-2],
            corr="squar_exp",
            poly="constant",
            xlimits=xlimits,
            print_global=False,
        )
        sm.set_training_values(xt, yt)
        for j in range(n_var):
            sm.set_training_derivatives(xt, all_grad[:, j].reshape(-1, 1), j)
